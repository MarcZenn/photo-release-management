# Copy to .env.local and fill in real values. Never commit .env.local.

# Local dev stack (from `supabase start` output) or the linked project's
# API settings (Project Settings > API in the Supabase dashboard).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS entirely — never expose to the frontend
# bundle or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=
